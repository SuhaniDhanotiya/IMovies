PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Seat hold time (minutes) while payment is pending
SEAT_HOLD_MINUTES=10

# Default admin created by `npm run seed`
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=Admin@123

# Email (optional). If SMTP_HOST is empty, emails are printed in the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=iMovies <no-reply@imovies.com>
